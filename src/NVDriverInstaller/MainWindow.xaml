<ui:FluentWindow x:Class="NVDriverInstaller.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:pages="clr-namespace:NVDriverInstaller.Views.Pages"
                  Title="NVDriver Installer"
                  Icon="pack://application:,,,/Assets/icon.ico"
                  Width="1040"
                  Height="700"
                  MinWidth="880"
                  MinHeight="600"
                  WindowStartupLocation="CenterScreen"
                  WindowBackdropType="Mica"
                  ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Windows 11 TitleBar integrated with Mica -->
        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="NVDriver Installer">
            <ui:TitleBar.Icon>
                <ui:ImageIcon>
                    <ui:ImageIcon.Source>
                        <BitmapImage UriSource="pack://application:,,,/Assets/icon.png" />
                    </ui:ImageIcon.Source>
                </ui:ImageIcon>
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <TextBlock Text="NVDriver Installer" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Modern Navigation View -->
        <ui:NavigationView Grid.Row="1"
                           x:Name="RootNavigation"
                           PaneDisplayMode="Left"
                           OpenPaneLength="220"
                           CompactPaneLength="48"
                           IsPaneToggleVisible="False"
                           IsBackButtonVisible="Collapsed">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Dashboard"
                                       Tag="Dashboard"
                                       Icon="{ui:SymbolIcon Desktop24}"
                                       NavigationCacheMode="Required"
                                       TargetPageType="{x:Type pages:DashboardPage}" />

                <ui:NavigationViewItem Content="Build Package"
                                       Tag="Build"
                                       Icon="{ui:SymbolIcon Box24}"
                                       NavigationCacheMode="Required"
                                       TargetPageType="{x:Type pages:BuildPage}" />

                <ui:NavigationViewItem Content="Install Package"
                                       Tag="Install"
                                       Icon="{ui:SymbolIcon ArrowSyncCircle24}"
                                       NavigationCacheMode="Required"
                                       TargetPageType="{x:Type pages:InstallPage}" />

                <ui:NavigationViewItem Content="Tools &amp; Utilities"
                                       Tag="Utilities"
                                       Icon="{ui:SymbolIcon Wrench24}"
                                       NavigationCacheMode="Required"
                                       TargetPageType="{x:Type pages:UtilitiesPage}" />
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Settings"
                                       Tag="Settings"
                                       Icon="{ui:SymbolIcon Settings24}"
                                       NavigationCacheMode="Required"
                                       TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>

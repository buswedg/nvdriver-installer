<Page x:Class="NVDriverInstaller.Views.Pages.InstallPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:NVDriverInstaller.ViewModels"
      Title="Install Package"
      Background="Transparent"
      Focusable="True">

    <Page.DataContext>
        <vm:InstallViewModel x:Name="ViewModel" />
    </Page.DataContext>

    <StackPanel Margin="32,24,32,32" MaxWidth="920">

            <!-- Page Title -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Install Package" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock Text="Choose installation pathway: direct standard in-place installation or clean DDU driver uninstallation."
                           FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Pathway Selector Cards (Standard Install First, Clean Upgrade Second) -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Option 1: Standard Install (Direct) -->
                <Border Grid.Column="0"
                        CornerRadius="8"
                        BorderThickness="1"
                        Padding="16,14"
                        Cursor="Hand"
                        MouseLeftButtonDown="OnStandardInstallPathwaySelected">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#121922" />
                            <Setter Property="BorderBrush" Value="#1E293B" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStandardInstall}" Value="True">
                                    <Setter Property="Background" Value="#0F2438" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="16" Height="16" CornerRadius="8" BorderThickness="2" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#475569" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStandardInstall}" Value="True">
                                                <Setter Property="BorderBrush" Value="#60A5FA" />
                                                <Setter Property="Background" Value="#60A5FA" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="Standard Install (Direct)" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="Direct in-place setup in Windows. Installs debloated package fast without reboots or DDU purging."
                                   FontSize="11"
                                   LineHeight="16"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Option 2: Clean Upgrade (DDU) -->
                <Border Grid.Column="2"
                        CornerRadius="8"
                        BorderThickness="1"
                        Padding="16,14"
                        Cursor="Hand"
                        MouseLeftButtonDown="OnCleanInstallPathwaySelected">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#121922" />
                            <Setter Property="BorderBrush" Value="#1E293B" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCleanInstall}" Value="True">
                                    <Setter Property="Background" Value="#0F2438" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="16" Height="16" CornerRadius="8" BorderThickness="2" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#475569" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCleanInstall}" Value="True">
                                                <Setter Property="BorderBrush" Value="#60A5FA" />
                                                <Setter Property="Background" Value="#60A5FA" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="Clean Upgrade (DDU)" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="Uninstalls existing drivers using Display Driver Uninstaller (DDU) before fresh install, with optional Safe Mode and quarantine."
                                   FontSize="11"
                                   LineHeight="16"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Config & Health Alerts Banner Section -->
            <ItemsControl ItemsSource="{Binding ActiveAlerts}" Margin="0,0,0,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="8"
                                BorderThickness="1"
                                Margin="0,0,0,10"
                                Padding="14,12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#221808" />
                                    <Setter Property="BorderBrush" Value="#5C3B11" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                                            <Setter Property="Background" Value="#260F13" />
                                            <Setter Property="BorderBrush" Value="#5F2028" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="Info">
                                            <Setter Property="Background" Value="#0F1F2C" />
                                            <Setter Property="BorderBrush" Value="#1E3A5F" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:SymbolIcon Symbol="Warning24" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Foreground" Value="#FBBF24" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                    <Setter Property="Foreground" Value="#F87171" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Info">
                                                    <Setter Property="Foreground" Value="#60A5FA" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="16" />
                                </StackPanel>

                                <ui:Button Grid.Column="2"
                                           Content="{Binding ActionText}"
                                           Appearance="Secondary"
                                           Tag="{Binding ActionKey}"
                                           Click="OnAlertActionClicked"
                                           VerticalAlignment="Center"
                                           Margin="14,0,0,0">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsLoadingTooling, RelativeSource={RelativeSource AncestorType=Page}}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ActionKey}" Value="download_ddu">
                                                    <Setter Property="Icon">
                                                        <Setter.Value>
                                                            <ui:SymbolIcon Symbol="ArrowDownload24" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ActionKey}" Value="download_7z">
                                                    <Setter Property="Icon">
                                                        <Setter.Value>
                                                            <ui:SymbolIcon Symbol="ArrowDownload24" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Card 1: Select Driver Package -->
            <ui:Card Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Margin="0,0,10,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource StatusPill}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCleanInstall}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="STEP 1" FontSize="10" FontWeight="Bold" Foreground="#60A5FA" />
                                </Border>
                                <TextBlock Text="Select Driver Package" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Select a built driver package to install"
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ui:Button Grid.Column="1"
                                   Content="Refresh"
                                   Appearance="Secondary"
                                   Height="30"
                                   Padding="12,0"
                                   VerticalAlignment="Center"
                                   Icon="{ui:SymbolIcon ArrowClockwise24}"
                                   Click="OnRefreshClicked" />
                    </Grid>

                    <ComboBox ItemsSource="{Binding AvailablePackages}"
                              SelectedItem="{Binding SelectedPackage}"
                              DisplayMemberPath="DisplayName"
                              Height="36" />

                    <!-- Built Packages Loaded Counter / Status (Below Dropdown, Green on Success, Red on Error/Empty) -->
                    <TextBlock Text="{Binding PackageStatusText}"
                               FontSize="12"
                               FontStyle="Italic"
                               Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#4ADE80" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPackageStatus}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PackageHasError}" Value="True">
                                        <Setter Property="Foreground" Value="#F87171" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </ui:Card>

            <!-- Card 2B (Clean Upgrade): Step 2 DDU Profile -->
            <Grid Margin="0,0,0,16">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCleanInstall}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <ui:Card Padding="18">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Style="{StaticResource StatusPill}" Margin="0,0,10,0">
                                    <TextBlock Text="STEP 2" FontSize="10" FontWeight="Bold" Foreground="#60A5FA" />
                                </Border>
                                <TextBlock Text="DDU Profile" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Select profile for DDU driver cleanup"
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ComboBox ItemsSource="{Binding DduProfiles}"
                                  SelectedItem="{Binding SelectedDduProfile}"
                                  DisplayMemberPath="DisplayName"
                                  Height="36" />

                        <!-- Warning if no DDU profiles found -->
                        <TextBlock Text="No valid DDU profiles found"
                                   FontSize="12"
                                   FontStyle="Italic"
                                   Foreground="#F87171"
                                   Margin="0,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNoDduProfiles}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>


                    </StackPanel>
                </ui:Card>
            </Grid>

            <!-- Card 3 (Clean Upgrade): Step 3 Workflow Automation Preferences -->
            <Grid Margin="0,0,0,16">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCleanInstall}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <ui:Card Padding="18">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Style="{StaticResource StatusPill}" Margin="0,0,10,0">
                                    <TextBlock Text="STEP 3" FontSize="10" FontWeight="Bold" Foreground="#60A5FA" />
                                </Border>
                                <TextBlock Text="Workflow Automation Preferences" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Configure automated tasks for the upgrade workflow"
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Separator Background="#1E293B" Margin="0,0,0,12" />

                        <!-- 1. Quarantine Network Adapters Toggle -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Quarantine Network Adapters" FontWeight="Medium" FontSize="13" />
                                <TextBlock Text="Temporarily disables Ethernet and Wi-Fi to stop Windows Update interference" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding QuarantineNetwork}" VerticalAlignment="Center" />
                        </Grid>

                        <Separator Background="#1E293B" Margin="0,0,0,12" />

                        <!-- 2. Safe Mode Reboot Before Driver Uninstall Toggle -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Safe Mode Reboot Before Driver Uninstall" FontWeight="Medium" FontSize="13" />
                                <TextBlock Text="Restarts into Safe Mode to run DDU (if disabled, DDU runs in current session)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoRebootSafeMode}" VerticalAlignment="Center" />
                        </Grid>

                        <Separator Background="#1E293B" Margin="0,0,0,12" />

                        <!-- 3. Normal Reboot After Driver Install Toggle -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Normal Reboot After Driver Install" FontWeight="Medium" FontSize="13" />
                                <TextBlock Text="Automatically restarts system after driver installation completes to finalize setup" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoRebootAfterInstall}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </ui:Card>
            </Grid>

            <!-- Action Toolbar Area with Dry-Run Mode Toggle & Dynamic Action Button -->
            <Grid Margin="0,4,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar Grid.Column="0"
                             IsIndeterminate="True"
                             Height="4"
                             VerticalAlignment="Center"
                             Margin="0,0,16,0">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <!-- Dry-Run Simulation Mode Switch Badge (Clean Upgrade Only) -->
                <Border Grid.Column="1"
                        Background="#0F172A"
                        BorderBrush="#1E293B"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,8"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCleanInstall}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Simulation Mode" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Text="Simulate workflow without changes" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ui:ToggleSwitch IsChecked="{Binding DryRunMode}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <ui:Button Grid.Column="2"
                           Content="{Binding ActionButtonText}"
                           Appearance="Primary"
                           Style="{StaticResource ActionButtonStyle}"
                           IsEnabled="{Binding CanInstall}"
                           Click="OnExecuteInstallClicked"
                           VerticalAlignment="Center">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="{Binding ActionButtonSymbol}" Foreground="White" />
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>

            
        </StackPanel>
</Page>

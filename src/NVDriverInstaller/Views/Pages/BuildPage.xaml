<Page x:Class="NVDriverInstaller.Views.Pages.BuildPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:NVDriverInstaller.ViewModels"
      Title="Build Package"
      Background="Transparent"
      Focusable="True">

    <Page.DataContext>
        <vm:BuildViewModel x:Name="ViewModel" />
    </Page.DataContext>

    <StackPanel Margin="32,24,32,32" MaxWidth="920">

            <!-- Page Title -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Build Package" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock Text="Download official NVIDIA DCH drivers, purge telemetry plugins, and assemble a standalone installer."
                           FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Config & Health Alerts Banner Section -->
            <ItemsControl ItemsSource="{Binding ActiveAlerts}" Margin="0,0,0,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="8"
                                BorderThickness="1"
                                Margin="0,0,0,10"
                                Padding="14,12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#221808" />
                                    <Setter Property="BorderBrush" Value="#5C3B11" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                                            <Setter Property="Background" Value="#260F13" />
                                            <Setter Property="BorderBrush" Value="#5F2028" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="Info">
                                            <Setter Property="Background" Value="#0F1F2C" />
                                            <Setter Property="BorderBrush" Value="#1E3A5F" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:SymbolIcon Symbol="Warning24" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Foreground" Value="#FBBF24" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                    <Setter Property="Foreground" Value="#F87171" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Info">
                                                    <Setter Property="Foreground" Value="#60A5FA" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="16" />
                                </StackPanel>

                                <ui:Button Grid.Column="2"
                                           Content="{Binding ActionText}"
                                           Appearance="Secondary"
                                           Tag="{Binding ActionKey}"
                                           Click="OnAlertActionClicked"
                                           VerticalAlignment="Center"
                                           Margin="14,0,0,0">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsLoadingTooling, RelativeSource={RelativeSource AncestorType=Page}}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ActionKey}" Value="download_7z">
                                                    <Setter Property="Icon">
                                                        <Setter.Value>
                                                            <ui:SymbolIcon Symbol="ArrowDownload24" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ActionKey}" Value="check_catalog">
                                                    <Setter Property="Icon">
                                                        <Setter.Value>
                                                            <ui:SymbolIcon Symbol="ArrowSyncCircle24" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Card 1: NVIDIA Driver Version (Step 1) -->
            <ui:Card Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Style="{StaticResource StatusPill}" Margin="0,0,10,0">
                                    <TextBlock Text="STEP 1" FontSize="10" FontWeight="Bold" Foreground="#60A5FA" />
                                </Border>
                                <TextBlock Text="NVIDIA Driver Version" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Query NVIDIA driver catalog and select official release"
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ui:Button Grid.Column="1"
                                   Content="Refresh"
                                   Appearance="Secondary"
                                   Height="30"
                                   Padding="12,0"
                                   VerticalAlignment="Center"
                                   Icon="{ui:SymbolIcon ArrowClockwise24}"
                                   Click="OnQueryCatalogClicked" />
                    </Grid>

                    <ComboBox ItemsSource="{Binding CatalogPackages}"
                              SelectedItem="{Binding SelectedPackage}"
                              DisplayMemberPath="DisplayName"
                              Height="36" />

                    <!-- Releases Loaded Counter (Below Dropdown, Amber when Loading, Green on Success, Red on Error) -->
                    <TextBlock Text="{Binding CatalogStatusText}"
                               FontSize="12"
                               FontStyle="Italic"
                               Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#4ADE80" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCatalogStatus}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLoadingCatalog}" Value="True">
                                        <Setter Property="Foreground" Value="#FBBF24" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CatalogHasError}" Value="True">
                                        <Setter Property="Foreground" Value="#F87171" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </ui:Card>

            <!-- Card 2: Packaging Profile (Step 2) -->
            <ui:Card Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Style="{StaticResource StatusPill}" Margin="0,0,10,0">
                                <TextBlock Text="STEP 2" FontSize="10" FontWeight="Bold" Foreground="#60A5FA" />
                            </Border>
                            <TextBlock Text="Packaging Profile" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Select profile for driver debloating strategy"
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ComboBox ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding SelectedProfile}"
                              DisplayMemberPath="DisplayName"
                              Height="36" />

                    <!-- Warning if no profiles found -->
                    <TextBlock Text="No valid packaging profiles found"
                               FontSize="12"
                               FontStyle="Italic"
                               Foreground="#F87171"
                               Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoProfiles}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </ui:Card>



            <!-- Action Button Area (No outer grey card section) -->
            <Grid Margin="0,4,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar Grid.Column="0"
                             IsIndeterminate="True"
                             Height="4"
                             VerticalAlignment="Center"
                             Margin="0,0,16,0">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBuilding}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <ui:Button Grid.Column="1"
                           Content="{Binding ActionButtonText}"
                           Appearance="Primary"
                           Style="{StaticResource ActionButtonStyle}"
                           IsEnabled="{Binding CanBuild}"
                           Click="OnBuildClicked"
                           HorizontalAlignment="Right">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Box24" Foreground="White" />
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>


        </StackPanel>
</Page>

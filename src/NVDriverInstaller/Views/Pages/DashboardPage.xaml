<Page x:Class="NVDriverInstaller.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:NVDriverInstaller.ViewModels"
      Title="Dashboard"
      Background="Transparent"
      Focusable="True">

    <Page.DataContext>
        <vm:DashboardViewModel x:Name="ViewModel" />
    </Page.DataContext>

    <StackPanel Margin="32,24,32,32" MaxWidth="920">

            <!-- Hardware Hero Card -->
            <ui:Card Padding="18" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: GPU & Hardware Identity -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Icon Circle -->
                        <Border Width="52" Height="52" CornerRadius="10" Background="#13271F" BorderBrush="#1C4B35" BorderThickness="1" Margin="0,0,16,0" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Desktop24" FontSize="26" Foreground="#4ADE80" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding GpuSummary, FallbackValue='Detecting Display Hardware...'}"
                                       FontSize="17" FontWeight="SemiBold" Margin="0,0,0,6" />

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding HostInfo.PrimaryNvidiaGpu.FormattedNvidiaVersion, StringFormat='v{0}', FallbackValue='Active'}"
                                               FontSize="11" FontWeight="SemiBold" Foreground="#60A5FA" />
                                </Border>

                                <TextBlock Text="{Binding HostInfo.Hostname}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding HostInfo.FormFactor, FallbackValue='Desktop'}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding HostInfo.Manufacturer, FallbackValue='PC'}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: Live System State Badges -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <!-- Safe Mode Badge -->
                        <Border Margin="0,0,6,0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource SuccessPill}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HostInfo.IsSafeMode}" Value="True">
                                            <Setter Property="Background" Value="#2D2214" />
                                            <Setter Property="BorderBrush" Value="#4E3B1E" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="10" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Normal Boot" />
                                        <Setter Property="Foreground" Value="#4ADE80" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HostInfo.IsSafeMode}" Value="True">
                                                <Setter Property="Text" Value="SafeBoot Active" />
                                                <Setter Property="Foreground" Value="#FBBF24" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!-- Elevation Badge -->
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource SuccessPill}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HostInfo.IsElevated}" Value="False">
                                            <Setter Property="Background" Value="#2D2214" />
                                            <Setter Property="BorderBrush" Value="#4E3B1E" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="10">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Administrator" />
                                        <Setter Property="Foreground" Value="#4ADE80" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HostInfo.IsElevated}" Value="False">
                                                <Setter Property="Text" Value="Standard User" />
                                                <Setter Property="Foreground" Value="#FBBF24" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- Config & Health Alerts Banner Section -->
            <ItemsControl ItemsSource="{Binding ActiveAlerts}" Margin="0,0,0,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="8"
                                BorderThickness="1"
                                Margin="0,0,0,10"
                                Padding="14,12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#221808" />
                                    <Setter Property="BorderBrush" Value="#5C3B11" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                                            <Setter Property="Background" Value="#260F13" />
                                            <Setter Property="BorderBrush" Value="#5F2028" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:SymbolIcon Symbol="Warning24" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Foreground" Value="#FBBF24" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                    <Setter Property="Foreground" Value="#F87171" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="16" />
                                </StackPanel>

                                <ui:Button Grid.Column="2"
                                           Content="{Binding ActionText}"
                                           Appearance="Secondary"
                                           Tag="{Binding ActionKey}"
                                           Click="OnAlertActionClicked"
                                           VerticalAlignment="Center"
                                           Margin="14,0,0,0">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsLoading, RelativeSource={RelativeSource AncestorType=Page}}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ActionKey}" Value="download_ddu">
                                                    <Setter Property="Icon">
                                                        <Setter.Value>
                                                            <ui:SymbolIcon Symbol="ArrowDownload24" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ActionKey}" Value="download_7z">
                                                    <Setter Property="Icon">
                                                        <Setter.Value>
                                                            <ui:SymbolIcon Symbol="ArrowDownload24" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ActionKey}" Value="open_settings">
                                                    <Setter Property="Icon">
                                                        <Setter.Value>
                                                            <ui:SymbolIcon Symbol="Settings24" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ActionKey}" Value="check_catalog">
                                                    <Setter Property="Icon">
                                                        <Setter.Value>
                                                            <ui:SymbolIcon Symbol="ArrowSyncCircle24" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ActionKey}" Value="open_utilities">
                                                    <Setter Property="Icon">
                                                        <Setter.Value>
                                                            <ui:SymbolIcon Symbol="Wrench24" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Quick Action Cards Section (Equal Height & Dimensions) -->
            <TextBlock Text="Quick Actions" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Action 1: Build Driver Package -->
                <ui:CardAction Grid.Column="0"
                               Padding="18"
                               MinHeight="136"
                               VerticalAlignment="Stretch"
                               VerticalContentAlignment="Stretch"
                               Click="OnBuildPackageCardClicked">
                    <Grid VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="38" Height="38" CornerRadius="8" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Margin="0,0,12,0">
                                <ui:SymbolIcon Symbol="Box24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Build Driver Package" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   Text="Download official DCH packages, strip telemetry and unused drivers, and patch manifests into a clean installer."
                                   FontSize="12"
                                   LineHeight="18"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </ui:CardAction>

                <!-- Action 2: Install Driver Package -->
                <ui:CardAction Grid.Column="2"
                               Padding="18"
                               MinHeight="136"
                               VerticalAlignment="Stretch"
                               VerticalContentAlignment="Stretch"
                               Click="OnInstallPackageCardClicked">
                    <Grid VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="38" Height="38" CornerRadius="8" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Margin="0,0,12,0">
                                <ui:SymbolIcon Symbol="ArrowSyncCircle24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Install Driver Package" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   Text="Choose between full Safe Mode DDU cleanup with network isolation or direct in-place standard installation."
                                   FontSize="12"
                                   LineHeight="18"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </ui:CardAction>
            </Grid>

        </StackPanel>
</Page>

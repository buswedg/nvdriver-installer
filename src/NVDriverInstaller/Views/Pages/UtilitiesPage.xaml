<Page x:Class="NVDriverInstaller.Views.Pages.UtilitiesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:NVDriverInstaller.ViewModels"
      Title="Tools &amp; Utilities"
      Background="Transparent"
      Focusable="True">

    <Page.DataContext>
        <vm:UtilitiesViewModel x:Name="ViewModel" />
    </Page.DataContext>

    <StackPanel Margin="32,24,32,32" MaxWidth="920">

        <!-- Page Title -->
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Tools &amp; Utilities" FontSize="26" FontWeight="SemiBold" />
        </StackPanel>

        <!-- Status Banner / Notification -->
        <Border Margin="0,0,0,16" Padding="14,10" CornerRadius="6" Background="#2D2214" BorderBrush="#5C3B11" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasStatus}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="Info24" Foreground="#FBBF24" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="#F3F4F6" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Card 1: DDU Tool Card -->
        <ui:Card Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Display Driver Uninstaller (DDU)" FontSize="16" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <Border VerticalAlignment="Center"
                                Style="{StaticResource MutedPill}"
                                Background="{Binding DduStatusBadgeBackground}"
                                BorderBrush="{Binding DduStatusBadgeBorderBrush}">
                            <TextBlock Text="{Binding DduStatusBadgeText}"
                                       Foreground="{Binding DduStatusBadgeForeground}"
                                       FontSize="10"
                                       FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding DduStatusDescription}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- If Not Installed: Download DDU -->
                    <ui:Button Content="Download DDU"
                               Appearance="Primary"
                               Click="OnDownloadDduClicked">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowDownload24" Foreground="White" />
                        </ui:Button.Icon>
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDduInstalled}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>

                    <!-- If Installed: Check for Updates / Update DDU + Open DDU -->
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDduInstalled}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ui:Button Content="{Binding DduUpdateButtonText}"
                                   Margin="0,0,8,0"
                                   Click="OnDduUpdateOrCheckClicked">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Appearance" Value="Secondary" />
                                    <Setter Property="Icon">
                                        <Setter.Value>
                                            <ui:SymbolIcon Symbol="ArrowSyncCircle24" />
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDduUpdateAvailable}" Value="True">
                                            <Setter Property="Appearance" Value="Primary" />
                                            <Setter Property="Icon">
                                                <Setter.Value>
                                                    <ui:SymbolIcon Symbol="ArrowDownload24" Foreground="White" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <ui:Button Content="Open DDU"
                                   Click="OnOpenDduClicked">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Open24" Foreground="White" />
                            </ui:Button.Icon>
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Appearance" Value="Primary" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDduUpdateAvailable}" Value="True">
                                            <Setter Property="Appearance" Value="Secondary" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- Card 2: 7-Zip Tool Card -->
        <ui:Card Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="7-Zip SFX &amp; Packaging Tool" FontSize="16" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <Border VerticalAlignment="Center"
                                Style="{StaticResource MutedPill}"
                                Background="{Binding SevenZipStatusBadgeBackground}"
                                BorderBrush="{Binding SevenZipStatusBadgeBorderBrush}">
                            <TextBlock Text="{Binding SevenZipStatusBadgeText}"
                                       Foreground="{Binding SevenZipStatusBadgeForeground}"
                                       FontSize="10"
                                       FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding SevenZipStatusDescription}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- If Not Installed: Download 7-Zip -->
                    <ui:Button Content="Download 7-Zip"
                               Appearance="Primary"
                               Click="OnDownloadSevenZipClicked">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowDownload24" Foreground="White" />
                        </ui:Button.Icon>
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSevenZipInstalled}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>

                    <!-- If Installed: Check for Updates / Update 7-Zip + Open Tools Folder -->
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSevenZipInstalled}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ui:Button Content="{Binding SevenZipUpdateButtonText}"
                                   Margin="0,0,8,0"
                                   Click="OnSevenZipUpdateOrCheckClicked">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Appearance" Value="Secondary" />
                                    <Setter Property="Icon">
                                        <Setter.Value>
                                            <ui:SymbolIcon Symbol="ArrowSyncCircle24" />
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSevenZipUpdateAvailable}" Value="True">
                                            <Setter Property="Appearance" Value="Primary" />
                                            <Setter Property="Icon">
                                                <Setter.Value>
                                                    <ui:SymbolIcon Symbol="ArrowDownload24" Foreground="White" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <ui:Button Content="Open 7z"
                                   Click="OnOpenSevenZipClicked">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Open24" Foreground="White" />
                            </ui:Button.Icon>
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Appearance" Value="Primary" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSevenZipUpdateAvailable}" Value="True">
                                            <Setter Property="Appearance" Value="Secondary" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- Card 3: Windows BCD Safe Mode Controls -->
        <ui:Card Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Windows BCD Safe Mode Controls" FontSize="16" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <Border VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource SuccessPill}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSafeModeArmed}" Value="True">
                                            <Setter Property="Background" Value="#2D2214" />
                                            <Setter Property="BorderBrush" Value="#4E3B1E" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="10" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Normal Boot" />
                                        <Setter Property="Foreground" Value="#4ADE80" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSafeModeArmed}" Value="True">
                                                <Setter Property="Text" Value="SafeBoot Active" />
                                                <Setter Property="Foreground" Value="#FBBF24" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding SafeModeStatusDescription}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <ui:Button Grid.Column="1"
                           Content="{Binding SafeModeButtonText}"
                           Click="OnToggleSafeModeClicked"
                           VerticalAlignment="Center">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Appearance" Value="Secondary" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSafeModeArmed}" Value="True">
                                    <Setter Property="Appearance" Value="Danger" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
            </Grid>
        </ui:Card>

        <!-- Card 4: Physical Network Adapters (Quarantine) -->
        <ui:Card Padding="18" Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Physical Network Adapters" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="Disable All"
                                   Appearance="Danger"
                                   Margin="0,0,8,0"
                                   Click="OnDisableAllNetworkClicked" />

                        <ui:Button Content="Enable All"
                                   Appearance="Primary"
                                   Click="OnEnableAllNetworkClicked" />
                    </StackPanel>
                </Grid>

                <Separator Background="#1E293B" Margin="0,0,0,12" />

                <!-- Adapter List -->
                <ItemsControl ItemsSource="{Binding Adapters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0F1722"
                                    BorderBrush="#1E293B"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,10"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ui:SymbolIcon Symbol="Router24" FontSize="18" Foreground="#60A5FA" Margin="0,0,12,0" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <!-- Adapter Name + Badge directly to the right -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />

                                            <!-- Status Badge -->
                                            <Border VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource MutedPill}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUp}" Value="True">
                                                                <Setter Property="Background" Value="#14261C" />
                                                                <Setter Property="BorderBrush" Value="#1E472D" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsUp}" Value="False">
                                                                <Setter Property="Background" Value="#2D1518" />
                                                                <Setter Property="BorderBrush" Value="#5C2229" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="10" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Disabled" />
                                                            <Setter Property="Foreground" Value="#EF4444" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsUp}" Value="True">
                                                                    <Setter Property="Text" Value="Enabled" />
                                                                    <Setter Property="Foreground" Value="#4ADE80" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding InterfaceDescription}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- Individual Toggle Button -->
                                    <ui:Button Grid.Column="2"
                                               Tag="{Binding Name}"
                                               Click="OnToggleAdapterClicked"
                                               Height="28"
                                               Padding="14,0"
                                               VerticalAlignment="Center">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Setter Property="Content" Value="Enable" />
                                                <Setter Property="Appearance" Value="Primary" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUp}" Value="True">
                                                        <Setter Property="Content" Value="Disable" />
                                                        <Setter Property="Appearance" Value="Secondary" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ui:Card>

    </StackPanel>
</Page>

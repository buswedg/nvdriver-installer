# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit LF enforcement for source code, scripts, and configs
*.cs text eol=lf
*.xaml text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.svg text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows Command scripts require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.exe binary
*.dll binary
*.pdb binary
*.zip binary
*.7z binary
